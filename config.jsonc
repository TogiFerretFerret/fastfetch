        {
            "type": "custom",
            "format": "\u001b[38;2;83;94;0m╔══════════════════════════════════════════════════════╗"
        },
        {
            "type": "title",
            "format": "\u001b[38;2;83;94;0m║ \u001b[38;2;135;72;3mPILOT:\u001b[38;2;238;224;215m {user-name}                           \u001b[38;2;135;72;3mUNIT:\u001b[38;2;238;224;215m {host-name}\u001b[38;2;83;94;0m ║"

        },

        {
            "type": "custom",
            "format": "\u001b[38;2;83;94;0m╠══════════════════════════════════════════════════════╣"
        },

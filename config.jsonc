        {
            "type": "custom",
            "format": "\u001b[38;2;159;93;177m║ \u001b[38;2;241;175;255m╚═╝  ╚═══╝╚══════╝╚═╝  ╚═╝  ╚═══╝                   \u001b[38;2;159;93;177m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;159;93;177m╚══●\u001b[38;2;193;199;211m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[38;2;159;93;177m●══╝"
        },

        {
            "type": "custom",
            "format": "\u001b[38;2;159;93;177m╔══════════════════════════════════════════════════════╗"
        },
        {
            "type": "title",
            "format": "\u001b[38;2;159;93;177m║ \u001b[38;2;80;147;227mPILOT:\u001b[38;2;225;226;233m {user-name}                           \u001b[38;2;80;147;227mUNIT:\u001b[38;2;225;226;233m {host-name}\u001b[38;2;159;93;177m ║"

        },

        {
            "type": "custom",
            "format": "\u001b[38;2;159;93;177m╠══════════════════════════════════════════════════════╣"
        },
        // --- SECTION 1: HARDWARE (EVA STATUS) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;159;93;177m║ \u001b[38;2;80;147;227mEVA-01 HARDWARE STATUS                               \u001b[38;2;159;93;177m║"
        },
        {
            "type": "memory",
            "key": "\u001b[38;2;159;93;177m║\u001b[38;2;225;226;233m  LCL(RAM) ▌                                         \u001b[38;2;159;93;177m║"
        },
        {
            "type": "swap",
            "key": "\u001b[38;2;159;93;177m║\u001b[38;2;225;226;233m 󰓡 SWAP     ▌                                         \u001b[38;2;159;93;177m║"

            "format": "\u001b[38;2;83;94;0m╚══●\u001b[38;2;216;194;180m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[38;2;83;94;0m●══╝"

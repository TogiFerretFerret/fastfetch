{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/river/Pictures/Wallpapers/nyaa.png",
        "type": "kitty-direct",
        "height": 18,
		"width": 40
    },
	"display": {
        "separator": "",
        "key": {
            "width": 18
        },
        "bar": {
            "border": null,
            "char": {
                "elapsed": "█",
                "total": "░"
            },
            "width": 35
        }
    },
"modules": [
{
            "type": "custom",
            "format": "\u001b[38;2;210;156;236m╔══●\u001b[38;2;189;200;205m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[38;2;210;156;236m●══╗"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;210;156;236m║ \u001b[38;2;234;187;255m███╗   ██╗███████╗██████╗ ██╗   ██╗  \u001b[38;2;210;156;236mEVA-00 SYSTEM   \u001b[38;2;210;156;236m║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;210;156;236m║ \u001b[38;2;234;187;255m████╗  ██║██╔════╝██╔══██╗██║   ██║  \u001b[38;2;210;156;236mMAGI INTERFACE \u001b[38;2;210;156;236m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;210;156;236m║ \u001b[38;2;234;187;255m██╔██╗ ██║█████╗  ██████╔╝██║   ██║                  \u001b[38;2;210;156;236m║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;210;156;236m║ \u001b[38;2;234;187;255m██║╚██╗██║██╔══╝  ██╔══██╗╚██╗ ██╔╝  \u001b[38;2;71;190;222mCLASSIFIED     \u001b[38;2;210;156;236m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;210;156;236m║ \u001b[38;2;234;187;255m██║ ╚████║███████╗██║  ██║ ╚████╔╝   \u001b[38;2;71;190;222mACCESS ONLY    \u001b[38;2;210;156;236m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;210;156;236m║ \u001b[38;2;234;187;255m╚═╝  ╚═══╝╚══════╝╚═╝  ╚═╝  ╚═══╝                   \u001b[38;2;210;156;236m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;210;156;236m╚══●\u001b[38;2;189;200;205m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[38;2;210;156;236m●══╝"
        },

        {
            "type": "custom",
            "format": "\u001b[38;2;210;156;236m╔══════════════════════════════════════════════════════╗"
        },
        {
            "type": "title",
            "format": "\u001b[38;2;210;156;236m║ \u001b[38;2;71;190;222mPILOT:\u001b[38;2;222;227;230m {user-name}                           \u001b[38;2;71;190;222mUNIT:\u001b[38;2;222;227;230m {host-name}\u001b[38;2;210;156;236m ║"

        },

        {
            "type": "custom",
            "format": "\u001b[38;2;210;156;236m╠══════════════════════════════════════════════════════╣"
        },
        // --- SECTION 1: HARDWARE (EVA STATUS) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;210;156;236m║ \u001b[38;2;71;190;222mEVA-01 HARDWARE STATUS                               \u001b[38;2;210;156;236m║"
        },
        {
            "type": "memory",
            "key": "\u001b[38;2;210;156;236m║\u001b[38;2;222;227;230m  LCL(RAM) ▌                                         \u001b[38;2;210;156;236m║"
        },
        {
            "type": "swap",
            "key": "\u001b[38;2;210;156;236m║\u001b[38;2;222;227;230m 󰓡 SWAP     ▌                                         \u001b[38;2;210;156;236m║"
        },
        {
            "type": "disk",
            "key": "\u001b[38;2;210;156;236m║\u001b[38;2;222;227;230m  ENT PLUG ▌                                         \u001b[38;2;210;156;236m║",
            "folders": "/"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;210;156;236m╠══════════════════════════════════════════════════════╣"
        },

        // --- SECTION 2: DESKTOP (COMMAND UI) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;210;156;236m║ \u001b[38;2;71;190;222mCOMMAND INTERFACE                              \u001b[38;2;210;156;236m      ║"
        },{
            "type": "os",
            "key": "\u001b[38;2;210;156;236m║\u001b[38;2;222;227;230m  SYSTEM   ▌                                         \u001b[38;2;210;156;236m║",
            "format": "Asahi ALARM (Arch Linux)"
        },

        {
            "type": "kernel",
            "key": "\u001b[38;2;210;156;236m║\u001b[38;2;222;227;230m  KERNEL   ▌                                         \u001b[38;2;210;156;236m║",
        	"format": "{1} {2~0,7} {2~12,50}"
		},
        {
            "type": "wm",
            "key": "\u001b[38;2;210;156;236m║\u001b[38;2;222;227;230m  VISUAL   ▌                                         \u001b[38;2;210;156;236m║",
            "format": "{2} ({3})"
        },
        {
            "type": "custom",
            "key": "\u001b[38;2;210;156;236m║\u001b[38;2;222;227;230m 󰾲 G-DRIVER ▌                                         \u001b[38;2;210;156;236m║",
            "format": "Asahi (Apple Silicon)"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;210;156;236m╠══════════════════════════════════════════════════════╣"
        },

        // --- SECTION 3: DEVELOPMENT (LANGUAGE PROTOCOLS) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;210;156;236m║ \u001b[38;2;71;190;222mLANGUAGE PROTOCOLS                                   \u001b[38;2;210;156;236m║"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;210;156;236m║\u001b[38;2;222;227;230m  RUST     ▌                                         \u001b[38;2;210;156;236m║",
            "text": "rustc --version | awk '{print $2}'"
        },
		 {
            "type": "command",
            "key": "\u001b[38;2;210;156;236m║\u001b[38;2;222;227;230m  NODE     ▌                                         \u001b[38;2;210;156;236m║",
            "text": "node --version 2>/dev/null || echo 'N/A'"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;210;156;236m║\u001b[38;2;222;227;230m  GO       ▌                                         \u001b[38;2;210;156;236m║",
            "text": "go version 2>/dev/null | awk '{print $3}' || echo 'N/A'"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;210;156;236m║\u001b[38;2;222;227;230m 󰊢 GIT      ▌                                         \u001b[38;2;210;156;236m║",
            "text": "git --version | awk '{print $3}'"
        },
        {
            "type": "editor",
            "key": "\u001b[38;2;210;156;236m║\u001b[38;2;222;227;230m 󱞎 EDITOR   ▌                                         \u001b[38;2;210;156;236m║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;210;156;236m╠══════════════════════════════════════════════════════╣"
        },

        // --- SECTION 4: MISSION STATUS (UPTIME) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;210;156;236m║ \u001b[38;2;71;190;222mMISSION STATUS                                       \u001b[38;2;210;156;236m║"
        },
        {
            "type": "uptime",
            "key": "\u001b[38;2;210;156;236m║\u001b[38;2;222;227;230m  ACTIVE   ▌                                         \u001b[38;2;210;156;236m║"
        },
        {
            "type": "packages",
            "key": "\u001b[38;2;210;156;236m║\u001b[38;2;222;227;230m 󰏖 PAYLOAD  ▌                                         \u001b[38;2;210;156;236m║"
        },
        {
            "type": "battery",
            "key": "\u001b[38;2;210;156;236m║\u001b[38;2;222;227;230m  PWR CELL ▌                                         \u001b[38;2;210;156;236m║",
			"format": "{4} ({15} remaining)"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;210;156;236m║\u001b[38;2;222;227;230m  PLAYBACK ▌                                         \u001b[38;2;210;156;236m║",
            "text": "bash /home/river/.config/waybar/scripts/mpk.sh|cut -c -37"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;210;156;236m╚══════════════════════════════════════════════════════╝"
        }
    ]
    }

	

            "format": "\u001b[38;2;159;93;177m║ \u001b[38;2;241;175;255m██╔██╗ ██║█████╗  ██████╔╝██║   ██║                  \u001b[38;2;159;93;177m║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;159;93;177m║ \u001b[38;2;241;175;255m██║╚██╗██║██╔══╝  ██╔══██╗╚██╗ ██╔╝  \u001b[38;2;80;147;227mCLASSIFIED     \u001b[38;2;159;93;177m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;159;93;177m║ \u001b[38;2;241;175;255m██║ ╚████║███████╗██║  ██║ ╚████╔╝   \u001b[38;2;80;147;227mACCESS ONLY    \u001b[38;2;159;93;177m ║"

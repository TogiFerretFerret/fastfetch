        },

        // --- SECTION 2: DESKTOP (COMMAND UI) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;83;94;0m║ \u001b[38;2;135;72;3mCOMMAND INTERFACE                              \u001b[38;2;83;94;0m      ║"
        },
        {
            "type": "os",
            "key": "\u001b[38;2;83;94;0m║\u001b[38;2;238;224;215m  SYSTEM   ▌                                         \u001b[38;2;83;94;0m║",
            "format": "{2} {8~0,2}"
        },
        {
            "type": "kernel",
            "key": "\u001b[38;2;83;94;0m║\u001b[38;2;238;224;215m  KERNEL   ▌                                         \u001b[38;2;83;94;0m║",
        	"format": "{1} {2~0,7} {2~12,50}"
		},
        {
            "type": "wm",
            "key": "\u001b[38;2;83;94;0m║\u001b[38;2;238;224;215m  VISUAL   ▌                                         \u001b[38;2;83;94;0m║",
            "format": "{2} ({3})"
        },
        {
            "type": "custom",
            "key": "\u001b[38;2;83;94;0m║\u001b[38;2;238;224;215m 󰾲 G-DRIVER ▌                                         \u001b[38;2;83;94;0m║",
            "format": "Asahi (Apple Silicon)"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;83;94;0m╠══════════════════════════════════════════════════════╣"
        },

        // --- SECTION 3: DEVELOPMENT (LANGUAGE PROTOCOLS) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;83;94;0m║ \u001b[38;2;135;72;3mLANGUAGE PROTOCOLS                                   \u001b[38;2;83;94;0m║"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;83;94;0m║\u001b[38;2;238;224;215m  RUST     ▌                                         \u001b[38;2;83;94;0m║",
            "text": "rustc --version | awk '{print $2}'"
        },
		 {
            "type": "command",
            "key": "\u001b[38;2;83;94;0m║\u001b[38;2;238;224;215m  NODE     ▌                                         \u001b[38;2;83;94;0m║",
            "text": "node --version 2>/dev/null || echo 'N/A'"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;83;94;0m║\u001b[38;2;238;224;215m  GO       ▌                                         \u001b[38;2;83;94;0m║",
            "text": "go version 2>/dev/null | awk '{print $3}' || echo 'N/A'"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;83;94;0m║\u001b[38;2;238;224;215m 󰊢 GIT      ▌                                         \u001b[38;2;83;94;0m║",
            "text": "git --version | awk '{print $3}'"
        },

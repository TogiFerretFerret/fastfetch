            "key": "\u001b[38;2;159;93;177m║\u001b[38;2;225;226;233m  PLAYBACK ▌                                         \u001b[38;2;159;93;177m║",
            "text": "bash /home/river/.config/waybar/scripts/mpk.sh|cut -c -37"
        },
        {

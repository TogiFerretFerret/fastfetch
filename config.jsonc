        },
        {
            "type": "custom",
            "format": "\u001b[38;2;83;94;0m╠══════════════════════════════════════════════════════╣"
        },

        // --- SECTION 4: MISSION STATUS (UPTIME) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;83;94;0m║ \u001b[38;2;135;72;3mMISSION STATUS                                       \u001b[38;2;83;94;0m║"
        },
        {

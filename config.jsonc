        },
        {
            "type": "custom",
            "format": "\u001b[38;2;159;93;177m╠══════════════════════════════════════════════════════╣"
        },

        // --- SECTION 2: DESKTOP (COMMAND UI) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;159;93;177m║ \u001b[38;2;80;147;227mCOMMAND INTERFACE                              \u001b[38;2;159;93;177m      ║"
        },
        {
            "type": "os",
            "key": "\u001b[38;2;159;93;177m║\u001b[38;2;225;226;233m  SYSTEM   ▌                                         \u001b[38;2;159;93;177m║",
            "format": "{2} {8~0,2}"
        },
        {
            "type": "kernel",
            "key": "\u001b[38;2;159;93;177m║\u001b[38;2;225;226;233m  KERNEL   ▌                                         \u001b[38;2;159;93;177m║",
        	"format": "{1} {2~0,7} {2~12,50}"
		},
        {
            "type": "wm",
            "key": "\u001b[38;2;159;93;177m║\u001b[38;2;225;226;233m  VISUAL   ▌                                         \u001b[38;2;159;93;177m║",
            "format": "{2} ({3})"
        },
        {
            "type": "custom",
            "key": "\u001b[38;2;159;93;177m║\u001b[38;2;225;226;233m 󰾲 G-DRIVER ▌                                         \u001b[38;2;159;93;177m║",
            "format": "Asahi (Apple Silicon)"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;159;93;177m╠══════════════════════════════════════════════════════╣"
        },

        // --- SECTION 3: DEVELOPMENT (LANGUAGE PROTOCOLS) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;159;93;177m║ \u001b[38;2;80;147;227mLANGUAGE PROTOCOLS                                   \u001b[38;2;159;93;177m║"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;159;93;177m║\u001b[38;2;225;226;233m  RUST     ▌                                         \u001b[38;2;159;93;177m║",
            "text": "rustc --version | awk '{print $2}'"
        },
		 {
            "type": "command",
            "key": "\u001b[38;2;159;93;177m║\u001b[38;2;225;226;233m  NODE     ▌                                         \u001b[38;2;159;93;177m║",
            "text": "node --version 2>/dev/null || echo 'N/A'"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;159;93;177m║\u001b[38;2;225;226;233m  GO       ▌                                         \u001b[38;2;159;93;177m║",
            "text": "go version 2>/dev/null | awk '{print $3}' || echo 'N/A'"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;159;93;177m║\u001b[38;2;225;226;233m 󰊢 GIT      ▌                                         \u001b[38;2;159;93;177m║",
            "text": "git --version | awk '{print $3}'"
        },
        {
            "type": "editor",
            "key": "\u001b[38;2;159;93;177m║\u001b[38;2;225;226;233m 󱞎 EDITOR   ▌                                         \u001b[38;2;159;93;177m║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;159;93;177m╠══════════════════════════════════════════════════════╣"
        },

        // --- SECTION 4: MISSION STATUS (UPTIME) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;159;93;177m║ \u001b[38;2;80;147;227mMISSION STATUS                                       \u001b[38;2;159;93;177m║"
        },
        {
            "type": "uptime",
            "key": "\u001b[38;2;159;93;177m║\u001b[38;2;225;226;233m  ACTIVE   ▌                                         \u001b[38;2;159;93;177m║"
        },
        {
            "type": "packages",
            "key": "\u001b[38;2;159;93;177m║\u001b[38;2;225;226;233m 󰏖 PAYLOAD  ▌                                         \u001b[38;2;159;93;177m║"
        },
        {
            "type": "battery",
            "key": "\u001b[38;2;159;93;177m║\u001b[38;2;225;226;233m  PWR CELL ▌                                         \u001b[38;2;159;93;177m║",
			"format": "{4} ({15} remaining)"
        },
        {

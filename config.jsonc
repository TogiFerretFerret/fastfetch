        },
        {
            "type": "custom",
            "format": "\u001b[38;2;83;94;0m║ \u001b[38;2;193;206;107m██║ ╚████║███████╗██║  ██║ ╚████╔╝   \u001b[38;2;135;72;3mACCESS ONLY    \u001b[38;2;83;94;0m ║"

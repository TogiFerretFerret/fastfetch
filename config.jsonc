{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/river/Pictures/Wallpapers/epicfetch.png",
        "type": "kitty-direct",
        "height": 22
    },
	"display": {
        "separator": "",
        "key": {
            "width": 18
        },
        "bar": {
            "border": null,
            "char": {
                "elapsed": "█",
                "total": "░"
            },
            "width": 35
        }
    },
"modules": [
{
            "type": "custom",
            "format": "\u001b[38;2;154;73;173m╔══●\u001b[38;2;195;198;213m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[38;2;154;73;173m●══╗"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;154;73;173m║ \u001b[38;2;244;174;255m███╗   ██╗███████╗██████╗ ██╗   ██╗  \u001b[38;2;154;73;173mEVA-00 SYSTEM   \u001b[38;2;154;73;173m║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;154;73;173m║ \u001b[38;2;244;174;255m████╗  ██║██╔════╝██╔══██╗██║   ██║  \u001b[38;2;154;73;173mMAGI INTERFACE \u001b[38;2;154;73;173m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;154;73;173m║ \u001b[38;2;244;174;255m██╔██╗ ██║█████╗  ██████╔╝██║   ██║                  \u001b[38;2;154;73;173m║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;154;73;173m║ \u001b[38;2;244;174;255m██║╚██╗██║██╔══╝  ██╔══██╗╚██╗ ██╔╝  \u001b[38;2;46;102;209mCLASSIFIED     \u001b[38;2;154;73;173m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;154;73;173m║ \u001b[38;2;244;174;255m██║ ╚████║███████╗██║  ██║ ╚████╔╝   \u001b[38;2;46;102;209mACCESS ONLY    \u001b[38;2;154;73;173m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;154;73;173m║ \u001b[38;2;244;174;255m╚═╝  ╚═══╝╚══════╝╚═╝  ╚═╝  ╚═══╝                   \u001b[38;2;154;73;173m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;154;73;173m╚══●\u001b[38;2;195;198;213m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[38;2;154;73;173m●══╝"
        },

        {
            "type": "custom",
            "format": "\u001b[38;2;154;73;173m╔══════════════════════════════════════════════════════╗"
        },
        {
            "type": "title",
            "format": "\u001b[38;2;154;73;173m║ \u001b[38;2;46;102;209mPILOT:\u001b[38;2;225;226;235m {user-name}                           \u001b[38;2;46;102;209mUNIT:\u001b[38;2;225;226;235m {host-name}\u001b[38;2;154;73;173m ║"

        },

        {
            "type": "custom",
            "format": "\u001b[38;2;154;73;173m╠══════════════════════════════════════════════════════╣"
        },
        // --- SECTION 1: HARDWARE (EVA STATUS) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;154;73;173m║ \u001b[38;2;46;102;209mEVA-01 HARDWARE STATUS                               \u001b[38;2;154;73;173m║"
        },
        {
            "type": "memory",
            "key": "\u001b[38;2;154;73;173m║\u001b[38;2;225;226;235m  LCL(RAM) ▌                                         \u001b[38;2;154;73;173m║"
        },
        {
            "type": "swap",
            "key": "\u001b[38;2;154;73;173m║\u001b[38;2;225;226;235m 󰓡 SWAP     ▌                                         \u001b[38;2;154;73;173m║"
        },
        {
            "type": "disk",
            "key": "\u001b[38;2;154;73;173m║\u001b[38;2;225;226;235m  ENT PLUG ▌                                         \u001b[38;2;154;73;173m║",
            "folders": "/"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;154;73;173m╠══════════════════════════════════════════════════════╣"
        },

        // --- SECTION 2: DESKTOP (COMMAND UI) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;154;73;173m║ \u001b[38;2;46;102;209mCOMMAND INTERFACE                              \u001b[38;2;154;73;173m      ║"
        },
        {
            "type": "os",
            "key": "\u001b[38;2;154;73;173m║\u001b[38;2;225;226;235m  SYSTEM   ▌                                         \u001b[38;2;154;73;173m║",
            "format": "{2} {8~0,2}"
        },
        {
            "type": "kernel",
            "key": "\u001b[38;2;154;73;173m║\u001b[38;2;225;226;235m  KERNEL   ▌                                         \u001b[38;2;154;73;173m║",
        	"format": "{1} {2~0,7} {2~12,50}"
		},
        {
            "type": "wm",
            "key": "\u001b[38;2;154;73;173m║\u001b[38;2;225;226;235m  VISUAL   ▌                                         \u001b[38;2;154;73;173m║",
            "format": "{2} ({3})"
        },
        {
            "type": "custom",
            "key": "\u001b[38;2;154;73;173m║\u001b[38;2;225;226;235m 󰾲 G-DRIVER ▌                                         \u001b[38;2;154;73;173m║",
            "format": "Asahi (Apple Silicon)"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;154;73;173m╠══════════════════════════════════════════════════════╣"
        },

        // --- SECTION 3: DEVELOPMENT (LANGUAGE PROTOCOLS) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;154;73;173m║ \u001b[38;2;46;102;209mLANGUAGE PROTOCOLS                                   \u001b[38;2;154;73;173m║"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;154;73;173m║\u001b[38;2;225;226;235m  RUST     ▌                                         \u001b[38;2;154;73;173m║",
            "text": "rustc --version | awk '{print $2}'"
        },
		 {
            "type": "command",
            "key": "\u001b[38;2;154;73;173m║\u001b[38;2;225;226;235m  NODE     ▌                                         \u001b[38;2;154;73;173m║",
            "text": "node --version 2>/dev/null || echo 'N/A'"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;154;73;173m║\u001b[38;2;225;226;235m  GO       ▌                                         \u001b[38;2;154;73;173m║",
            "text": "go version 2>/dev/null | awk '{print $3}' || echo 'N/A'"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;154;73;173m║\u001b[38;2;225;226;235m 󰊢 GIT      ▌                                         \u001b[38;2;154;73;173m║",
            "text": "git --version | awk '{print $3}'"
        },
        {
            "type": "editor",
            "key": "\u001b[38;2;154;73;173m║\u001b[38;2;225;226;235m 󱞎 EDITOR   ▌                                         \u001b[38;2;154;73;173m║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;154;73;173m╠══════════════════════════════════════════════════════╣"
        },

        // --- SECTION 4: MISSION STATUS (UPTIME) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;154;73;173m║ \u001b[38;2;46;102;209mMISSION STATUS                                       \u001b[38;2;154;73;173m║"
        },
        {
            "type": "uptime",
            "key": "\u001b[38;2;154;73;173m║\u001b[38;2;225;226;235m  ACTIVE   ▌                                         \u001b[38;2;154;73;173m║"
        },
        {
            "type": "packages",
            "key": "\u001b[38;2;154;73;173m║\u001b[38;2;225;226;235m 󰏖 PAYLOAD  ▌                                         \u001b[38;2;154;73;173m║"
        },
        {
            "type": "battery",
            "key": "\u001b[38;2;154;73;173m║\u001b[38;2;225;226;235m  PWR CELL ▌                                         \u001b[38;2;154;73;173m║",
			"format": "{4} ({15} remaining)"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;154;73;173m║\u001b[38;2;225;226;235m  PLAYBACK ▌                                         \u001b[38;2;154;73;173m║",
            "text": "bash /home/river/.config/waybar/scripts/mpk.sh|cut -c -37"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;154;73;173m╚══════════════════════════════════════════════════════╝"
        }
    ]
    }

	

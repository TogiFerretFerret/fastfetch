"modules": [
{
            "type": "custom",
            "format": "\u001b[38;2;224;225;244m╔══●\u001b[38;2;193;200;198m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[38;2;224;225;244m●══╗"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;224;225;244m║ \u001b[38;2;255;255;255m███╗   ██╗███████╗██████╗ ██╗   ██╗  \u001b[38;2;224;225;244mEVA-00 SYSTEM   \u001b[38;2;224;225;244m║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;224;225;244m║ \u001b[38;2;255;255;255m████╗  ██║██╔════╝██╔══██╗██║   ██║  \u001b[38;2;224;225;244mMAGI INTERFACE \u001b[38;2;224;225;244m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;224;225;244m║ \u001b[38;2;255;255;255m██╔██╗ ██║█████╗  ██████╔╝██║   ██║                  \u001b[38;2;224;225;244m║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;224;225;244m║ \u001b[38;2;255;255;255m██║╚██╗██║██╔══╝  ██╔══██╗╚██╗ ██╔╝  \u001b[38;2;202;233;230mCLASSIFIED     \u001b[38;2;224;225;244m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;224;225;244m║ \u001b[38;2;255;255;255m██║ ╚████║███████╗██║  ██║ ╚████╔╝   \u001b[38;2;202;233;230mACCESS ONLY    \u001b[38;2;224;225;244m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;224;225;244m║ \u001b[38;2;255;255;255m╚═╝  ╚═══╝╚══════╝╚═╝  ╚═╝  ╚═══╝                   \u001b[38;2;224;225;244m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;224;225;244m╚══●\u001b[38;2;193;200;198m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[38;2;224;225;244m●══╝"
        },

        {
            "type": "custom",
            "format": "\u001b[38;2;224;225;244m╔══════════════════════════════════════════════════════╗"
        },
        {
            "type": "title",
            "format": "\u001b[38;2;224;225;244m║ \u001b[38;2;202;233;230mPILOT:\u001b[38;2;227;226;225m {user-name}                           \u001b[38;2;202;233;230mUNIT:\u001b[38;2;227;226;225m {host-name}\u001b[38;2;224;225;244m ║"

        },

        {
            "type": "custom",
            "format": "\u001b[38;2;224;225;244m╠══════════════════════════════════════════════════════╣"
        },
        // --- SECTION 1: HARDWARE (EVA STATUS) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;224;225;244m║ \u001b[38;2;202;233;230mEVA-01 HARDWARE STATUS                               \u001b[38;2;224;225;244m║"
        },
        {
            "type": "memory",
            "key": "\u001b[38;2;224;225;244m║\u001b[38;2;227;226;225m  LCL(RAM) ▌                                         \u001b[38;2;224;225;244m║"
        },
        {
            "type": "swap",
            "key": "\u001b[38;2;224;225;244m║\u001b[38;2;227;226;225m 󰓡 SWAP     ▌                                         \u001b[38;2;224;225;244m║"
        },
        {
            "type": "disk",
            "key": "\u001b[38;2;224;225;244m║\u001b[38;2;227;226;225m  ENT PLUG ▌                                         \u001b[38;2;224;225;244m║",
            "folders": "/"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;224;225;244m╠══════════════════════════════════════════════════════╣"
        },

        // --- SECTION 2: DESKTOP (COMMAND UI) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;224;225;244m║ \u001b[38;2;202;233;230mCOMMAND INTERFACE                              \u001b[38;2;224;225;244m      ║"
        },{
            "type": "os",
            "key": "\u001b[38;2;224;225;244m║\u001b[38;2;227;226;225m  SYSTEM   ▌                                         \u001b[38;2;224;225;244m║",
            "format": "Asahi ALARM (Arch Linux)"
        },

        {
            "type": "kernel",
            "key": "\u001b[38;2;224;225;244m║\u001b[38;2;227;226;225m  KERNEL   ▌                                         \u001b[38;2;224;225;244m║",
        	"format": "{1} {2~0,7} {2~12,50}"
		},
        {
            "type": "wm",
            "key": "\u001b[38;2;224;225;244m║\u001b[38;2;227;226;225m  VISUAL   ▌                                         \u001b[38;2;224;225;244m║",
            "format": "{2} ({3})"
        },
        {
            "type": "custom",
            "key": "\u001b[38;2;224;225;244m║\u001b[38;2;227;226;225m 󰾲 G-DRIVER ▌                                         \u001b[38;2;224;225;244m║",
            "format": "Asahi (Apple Silicon)"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;224;225;244m╠══════════════════════════════════════════════════════╣"
        },

        // --- SECTION 3: DEVELOPMENT (LANGUAGE PROTOCOLS) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;224;225;244m║ \u001b[38;2;202;233;230mLANGUAGE PROTOCOLS                                   \u001b[38;2;224;225;244m║"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;224;225;244m║\u001b[38;2;227;226;225m  RUST     ▌                                         \u001b[38;2;224;225;244m║",
            "text": "rustc --version | awk '{print $2}'"
        },
		 {
            "type": "command",
            "key": "\u001b[38;2;224;225;244m║\u001b[38;2;227;226;225m  NODE     ▌                                         \u001b[38;2;224;225;244m║",
            "text": "node --version 2>/dev/null || echo 'N/A'"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;224;225;244m║\u001b[38;2;227;226;225m  GO       ▌                                         \u001b[38;2;224;225;244m║",
            "text": "go version 2>/dev/null | awk '{print $3}' || echo 'N/A'"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;224;225;244m║\u001b[38;2;227;226;225m 󰊢 GIT      ▌                                         \u001b[38;2;224;225;244m║",
            "text": "git --version | awk '{print $3}'"
        },
        {
            "type": "editor",
            "key": "\u001b[38;2;224;225;244m║\u001b[38;2;227;226;225m 󱞎 EDITOR   ▌                                         \u001b[38;2;224;225;244m║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;224;225;244m╠══════════════════════════════════════════════════════╣"
        },

        // --- SECTION 4: MISSION STATUS (UPTIME) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;224;225;244m║ \u001b[38;2;202;233;230mMISSION STATUS                                       \u001b[38;2;224;225;244m║"
        },
        {
            "type": "uptime",
            "key": "\u001b[38;2;224;225;244m║\u001b[38;2;227;226;225m  ACTIVE   ▌                                         \u001b[38;2;224;225;244m║"
        },
        {
            "type": "packages",
            "key": "\u001b[38;2;224;225;244m║\u001b[38;2;227;226;225m 󰏖 PAYLOAD  ▌                                         \u001b[38;2;224;225;244m║"
        },
        {
            "type": "battery",
            "key": "\u001b[38;2;224;225;244m║\u001b[38;2;227;226;225m  PWR CELL ▌                                         \u001b[38;2;224;225;244m║",
			"format": "{4} ({15} remaining)"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;224;225;244m║\u001b[38;2;227;226;225m  PLAYBACK ▌                                         \u001b[38;2;224;225;244m║",
            "text": "bash /home/river/.config/waybar/scripts/mpk.sh|cut -c -37"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;224;225;244m╚══════════════════════════════════════════════════════╝"
        }
    ]
    }

	

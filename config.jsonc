        },
        {
            "type": "custom",
            "format": "\u001b[38;2;248;76;171m║ \u001b[38;2;255;175;209m███╗   ██╗███████╗██████╗ ██╗   ██╗  \u001b[38;2;248;76;171mEVA-00 SYSTEM   \u001b[38;2;248;76;171m║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;248;76;171m║ \u001b[38;2;255;175;209m████╗  ██║██╔════╝██╔══██╗██║   ██║  \u001b[38;2;248;76;171mMAGI INTERFACE \u001b[38;2;248;76;171m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;248;76;171m║ \u001b[38;2;255;175;209m██╔██╗ ██║█████╗  ██████╔╝██║   ██║                  \u001b[38;2;248;76;171m║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;248;76;171m║ \u001b[38;2;255;175;209m██║╚██╗██║██╔══╝  ██╔══██╗╚██╗ ██╔╝  \u001b[38;2;193;103;255mCLASSIFIED     \u001b[38;2;248;76;171m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;248;76;171m║ \u001b[38;2;255;175;209m██║ ╚████║███████╗██║  ██║ ╚████╔╝   \u001b[38;2;193;103;255mACCESS ONLY    \u001b[38;2;248;76;171m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;248;76;171m║ \u001b[38;2;255;175;209m╚═╝  ╚═══╝╚══════╝╚═╝  ╚═╝  ╚═══╝                   \u001b[38;2;248;76;171m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;248;76;171m╚══●\u001b[38;2;209;193;214m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[38;2;248;76;171m●══╝"
        },

        {
            "type": "custom",
            "format": "\u001b[38;2;248;76;171m╔══════════════════════════════════════════════════════╗"
        },
        {
            "type": "title",
            "format": "\u001b[38;2;248;76;171m║ \u001b[38;2;193;103;255mPILOT:\u001b[38;2;235;222;237m {user-name}                           \u001b[38;2;193;103;255mUNIT:\u001b[38;2;235;222;237m {host-name}\u001b[38;2;248;76;171m ║"

        },

        {
            "type": "custom",
            "format": "\u001b[38;2;248;76;171m╠══════════════════════════════════════════════════════╣"
        },
        // --- SECTION 1: HARDWARE (EVA STATUS) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;248;76;171m║ \u001b[38;2;193;103;255mEVA-01 HARDWARE STATUS                               \u001b[38;2;248;76;171m║"
        },
        {
            "type": "memory",
            "key": "\u001b[38;2;248;76;171m║\u001b[38;2;235;222;237m  LCL(RAM) ▌                                         \u001b[38;2;248;76;171m║"
        },
        {
            "type": "swap",
            "key": "\u001b[38;2;248;76;171m║\u001b[38;2;235;222;237m 󰓡 SWAP     ▌                                         \u001b[38;2;248;76;171m║"
        },
        {
            "type": "disk",
            "key": "\u001b[38;2;248;76;171m║\u001b[38;2;235;222;237m  ENT PLUG ▌                                         \u001b[38;2;248;76;171m║",
            "folders": "/"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;248;76;171m╠══════════════════════════════════════════════════════╣"
        },

        // --- SECTION 2: DESKTOP (COMMAND UI) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;248;76;171m║ \u001b[38;2;193;103;255mCOMMAND INTERFACE                              \u001b[38;2;248;76;171m      ║"
        },
        {
            "type": "os",
            "key": "\u001b[38;2;248;76;171m║\u001b[38;2;235;222;237m  SYSTEM   ▌                                         \u001b[38;2;248;76;171m║",
            "format": "{2} {8~0,2}"
        },
        {
            "type": "kernel",
            "key": "\u001b[38;2;248;76;171m║\u001b[38;2;235;222;237m  KERNEL   ▌                                         \u001b[38;2;248;76;171m║",
        	"format": "{1} {2~0,7} {2~12,50}"
		},
        {
            "type": "wm",
            "key": "\u001b[38;2;248;76;171m║\u001b[38;2;235;222;237m  VISUAL   ▌                                         \u001b[38;2;248;76;171m║",
            "format": "{2} ({3})"
        },
        {
            "type": "custom",
            "key": "\u001b[38;2;248;76;171m║\u001b[38;2;235;222;237m 󰾲 G-DRIVER ▌                                         \u001b[38;2;248;76;171m║",
            "format": "Asahi (Apple Silicon)"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;248;76;171m╠══════════════════════════════════════════════════════╣"
        },

        // --- SECTION 3: DEVELOPMENT (LANGUAGE PROTOCOLS) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;248;76;171m║ \u001b[38;2;193;103;255mLANGUAGE PROTOCOLS                                   \u001b[38;2;248;76;171m║"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;248;76;171m║\u001b[38;2;235;222;237m  RUST     ▌                                         \u001b[38;2;248;76;171m║",
            "text": "rustc --version | awk '{print $2}'"
        },
		 {
            "type": "command",
            "key": "\u001b[38;2;248;76;171m║\u001b[38;2;235;222;237m  NODE     ▌                                         \u001b[38;2;248;76;171m║",
            "text": "node --version 2>/dev/null || echo 'N/A'"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;248;76;171m║\u001b[38;2;235;222;237m  GO       ▌                                         \u001b[38;2;248;76;171m║",
            "text": "go version 2>/dev/null | awk '{print $3}' || echo 'N/A'"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;248;76;171m║\u001b[38;2;235;222;237m 󰊢 GIT      ▌                                         \u001b[38;2;248;76;171m║",
            "text": "git --version | awk '{print $3}'"
        },
        {
            "type": "editor",
            "key": "\u001b[38;2;248;76;171m║\u001b[38;2;235;222;237m 󱞎 EDITOR   ▌                                         \u001b[38;2;248;76;171m║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;248;76;171m╠══════════════════════════════════════════════════════╣"
        },

        // --- SECTION 4: MISSION STATUS (UPTIME) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;248;76;171m║ \u001b[38;2;193;103;255mMISSION STATUS                                       \u001b[38;2;248;76;171m║"
        },
        {
            "type": "uptime",
            "key": "\u001b[38;2;248;76;171m║\u001b[38;2;235;222;237m  ACTIVE   ▌                                         \u001b[38;2;248;76;171m║"
        },
        {
            "type": "packages",
            "key": "\u001b[38;2;248;76;171m║\u001b[38;2;235;222;237m 󰏖 PAYLOAD  ▌                                         \u001b[38;2;248;76;171m║"
        },
        {
            "type": "battery",
            "key": "\u001b[38;2;248;76;171m║\u001b[38;2;235;222;237m  PWR CELL ▌                                         \u001b[38;2;248;76;171m║",
			"format": "{4} ({15} remaining)"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;248;76;171m║\u001b[38;2;235;222;237m  PLAYBACK ▌                                         \u001b[38;2;248;76;171m║",
            "text": "bash /home/river/.config/waybar/scripts/mpk.sh|cut -c -37"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;248;76;171m╚══════════════════════════════════════════════════════╝"

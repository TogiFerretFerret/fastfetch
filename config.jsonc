{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/river/Pictures/Wallpapers/epicfetch.png",
        "type": "kitty-direct",
        "height": 22
    },
	"display": {
        "separator": "",
        "key": {
            "width": 18
        },
        "bar": {
            "border": null,
            "char": {
                "elapsed": "█",
                "total": "░"
            },
            "width": 35
        }
    },
"modules": [
{
            "type": "custom",
            "format": "\u001b[38;2;181;189;122m╔══●\u001b[38;2;211;196;181m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[38;2;181;189;122m●══╗"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;181;189;122m║ \u001b[38;2;209;217;147m███╗   ██╗███████╗██████╗ ██╗   ██╗  \u001b[38;2;181;189;122mEVA-00 SYSTEM   \u001b[38;2;181;189;122m║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;181;189;122m║ \u001b[38;2;209;217;147m████╗  ██║██╔════╝██╔══██╗██║   ██║  \u001b[38;2;181;189;122mMAGI INTERFACE \u001b[38;2;181;189;122m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;181;189;122m║ \u001b[38;2;209;217;147m██╔██╗ ██║█████╗  ██████╔╝██║   ██║                  \u001b[38;2;181;189;122m║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;181;189;122m║ \u001b[38;2;209;217;147m██║╚██╗██║██╔══╝  ██╔══██╗╚██╗ ██╔╝  \u001b[38;2;225;175;112mCLASSIFIED     \u001b[38;2;181;189;122m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;181;189;122m║ \u001b[38;2;209;217;147m██║ ╚████║███████╗██║  ██║ ╚████╔╝   \u001b[38;2;225;175;112mACCESS ONLY    \u001b[38;2;181;189;122m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;181;189;122m║ \u001b[38;2;209;217;147m╚═╝  ╚═══╝╚══════╝╚═╝  ╚═╝  ╚═══╝                   \u001b[38;2;181;189;122m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;181;189;122m╚══●\u001b[38;2;211;196;181m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[38;2;181;189;122m●══╝"
        },

        {
            "type": "custom",
            "format": "\u001b[38;2;181;189;122m╔══════════════════════════════════════════════════════╗"
        },
        {
            "type": "title",
            "format": "\u001b[38;2;181;189;122m║ \u001b[38;2;225;175;112mPILOT:\u001b[38;2;234;225;217m {user-name}                           \u001b[38;2;225;175;112mUNIT:\u001b[38;2;234;225;217m {host-name}\u001b[38;2;181;189;122m ║"

        },

        {
            "type": "custom",
            "format": "\u001b[38;2;181;189;122m╠══════════════════════════════════════════════════════╣"
        },
        // --- SECTION 1: HARDWARE (EVA STATUS) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;181;189;122m║ \u001b[38;2;225;175;112mEVA-01 HARDWARE STATUS                               \u001b[38;2;181;189;122m║"
        },
        {
            "type": "memory",
            "key": "\u001b[38;2;181;189;122m║\u001b[38;2;234;225;217m  LCL(RAM) ▌                                         \u001b[38;2;181;189;122m║"
        },
        {
            "type": "swap",
            "key": "\u001b[38;2;181;189;122m║\u001b[38;2;234;225;217m 󰓡 SWAP     ▌                                         \u001b[38;2;181;189;122m║"
        },
        {
            "type": "disk",
            "key": "\u001b[38;2;181;189;122m║\u001b[38;2;234;225;217m  ENT PLUG ▌                                         \u001b[38;2;181;189;122m║",
            "folders": "/"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;181;189;122m╠══════════════════════════════════════════════════════╣"
        },

        // --- SECTION 2: DESKTOP (COMMAND UI) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;181;189;122m║ \u001b[38;2;225;175;112mCOMMAND INTERFACE                              \u001b[38;2;181;189;122m      ║"
        },{
            "type": "os",
            "key": "\u001b[38;2;181;189;122m║\u001b[38;2;234;225;217m  SYSTEM   ▌                                         \u001b[38;2;181;189;122m║",
            "format": "Asahi ALARM (Arch Linux)"
        },

        {
            "type": "kernel",
            "key": "\u001b[38;2;181;189;122m║\u001b[38;2;234;225;217m  KERNEL   ▌                                         \u001b[38;2;181;189;122m║",
        	"format": "{1} {2~0,7} {2~12,50}"
		},
        {
            "type": "wm",
            "key": "\u001b[38;2;181;189;122m║\u001b[38;2;234;225;217m  VISUAL   ▌                                         \u001b[38;2;181;189;122m║",
            "format": "{2} ({3})"
        },
        {
            "type": "custom",
            "key": "\u001b[38;2;181;189;122m║\u001b[38;2;234;225;217m 󰾲 G-DRIVER ▌                                         \u001b[38;2;181;189;122m║",
            "format": "Asahi (Apple Silicon)"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;181;189;122m╠══════════════════════════════════════════════════════╣"
        },

        // --- SECTION 3: DEVELOPMENT (LANGUAGE PROTOCOLS) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;181;189;122m║ \u001b[38;2;225;175;112mLANGUAGE PROTOCOLS                                   \u001b[38;2;181;189;122m║"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;181;189;122m║\u001b[38;2;234;225;217m  RUST     ▌                                         \u001b[38;2;181;189;122m║",
            "text": "rustc --version | awk '{print $2}'"
        },
		 {
            "type": "command",
            "key": "\u001b[38;2;181;189;122m║\u001b[38;2;234;225;217m  NODE     ▌                                         \u001b[38;2;181;189;122m║",
            "text": "node --version 2>/dev/null || echo 'N/A'"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;181;189;122m║\u001b[38;2;234;225;217m  GO       ▌                                         \u001b[38;2;181;189;122m║",
            "text": "go version 2>/dev/null | awk '{print $3}' || echo 'N/A'"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;181;189;122m║\u001b[38;2;234;225;217m 󰊢 GIT      ▌                                         \u001b[38;2;181;189;122m║",
            "text": "git --version | awk '{print $3}'"
        },
        {
            "type": "editor",
            "key": "\u001b[38;2;181;189;122m║\u001b[38;2;234;225;217m 󱞎 EDITOR   ▌                                         \u001b[38;2;181;189;122m║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;181;189;122m╠══════════════════════════════════════════════════════╣"
        },

        // --- SECTION 4: MISSION STATUS (UPTIME) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;181;189;122m║ \u001b[38;2;225;175;112mMISSION STATUS                                       \u001b[38;2;181;189;122m║"
        },
        {
            "type": "uptime",
            "key": "\u001b[38;2;181;189;122m║\u001b[38;2;234;225;217m  ACTIVE   ▌                                         \u001b[38;2;181;189;122m║"
        },
        {
            "type": "packages",
            "key": "\u001b[38;2;181;189;122m║\u001b[38;2;234;225;217m 󰏖 PAYLOAD  ▌                                         \u001b[38;2;181;189;122m║"
        },
        {
            "type": "battery",
            "key": "\u001b[38;2;181;189;122m║\u001b[38;2;234;225;217m  PWR CELL ▌                                         \u001b[38;2;181;189;122m║",
			"format": "{4} ({15} remaining)"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;181;189;122m║\u001b[38;2;234;225;217m  PLAYBACK ▌                                         \u001b[38;2;181;189;122m║",
            "text": "bash /home/river/.config/waybar/scripts/mpk.sh|cut -c -37"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;181;189;122m╚══════════════════════════════════════════════════════╝"
        }
    ]
    }

	

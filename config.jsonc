            "format": "\u001b[38;2;159;93;177m║ \u001b[38;2;241;175;255m███╗   ██╗███████╗██████╗ ██╗   ██╗  \u001b[38;2;159;93;177mEVA-00 SYSTEM   \u001b[38;2;159;93;177m║"

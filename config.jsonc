{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/home/river/Pictures/Wallpapers/epicfetch.png",
        "type": "kitty-direct",
        "height": 22
    },
	"display": {
        "separator": "",
        "key": {
            "width": 18
        },
        "bar": {
            "border": null,
            "char": {
                "elapsed": "█",
                "total": "░"
            },
            "width": 35
        }
    },
"modules": [
{
            "type": "custom",
            "format": "\u001b[38;2;191;120;187m╔══●\u001b[38;2;197;198;210m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[38;2;191;120;187m●══╗"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;191;120;187m║ \u001b[38;2;250;173;244m███╗   ██╗███████╗██████╗ ██╗   ██╗  \u001b[38;2;191;120;187mEVA-00 SYSTEM   \u001b[38;2;191;120;187m║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;191;120;187m║ \u001b[38;2;250;173;244m████╗  ██║██╔════╝██╔══██╗██║   ██║  \u001b[38;2;191;120;187mMAGI INTERFACE \u001b[38;2;191;120;187m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;191;120;187m║ \u001b[38;2;250;173;244m██╔██╗ ██║█████╗  ██████╔╝██║   ██║                  \u001b[38;2;191;120;187m║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;191;120;187m║ \u001b[38;2;250;173;244m██║╚██╗██║██╔══╝  ██╔══██╗╚██╗ ██╔╝  \u001b[38;2;118;141;219mCLASSIFIED     \u001b[38;2;191;120;187m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;191;120;187m║ \u001b[38;2;250;173;244m██║ ╚████║███████╗██║  ██║ ╚████╔╝   \u001b[38;2;118;141;219mACCESS ONLY    \u001b[38;2;191;120;187m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;191;120;187m║ \u001b[38;2;250;173;244m╚═╝  ╚═══╝╚══════╝╚═╝  ╚═╝  ╚═══╝                   \u001b[38;2;191;120;187m ║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;191;120;187m╚══●\u001b[38;2;197;198;210m━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\u001b[38;2;191;120;187m●══╝"
        },

        {
            "type": "custom",
            "format": "\u001b[38;2;191;120;187m╔══════════════════════════════════════════════════════╗"
        },
        {
            "type": "title",
            "format": "\u001b[38;2;191;120;187m║ \u001b[38;2;118;141;219mPILOT:\u001b[38;2;227;226;232m {user-name}                           \u001b[38;2;118;141;219mUNIT:\u001b[38;2;227;226;232m {host-name}\u001b[38;2;191;120;187m ║"

        },

        {
            "type": "custom",
            "format": "\u001b[38;2;191;120;187m╠══════════════════════════════════════════════════════╣"
        },
        // --- SECTION 1: HARDWARE (EVA STATUS) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;191;120;187m║ \u001b[38;2;118;141;219mEVA-01 HARDWARE STATUS                               \u001b[38;2;191;120;187m║"
        },
        {
            "type": "memory",
            "key": "\u001b[38;2;191;120;187m║\u001b[38;2;227;226;232m  LCL(RAM) ▌                                         \u001b[38;2;191;120;187m║"
        },
        {
            "type": "swap",
            "key": "\u001b[38;2;191;120;187m║\u001b[38;2;227;226;232m 󰓡 SWAP     ▌                                         \u001b[38;2;191;120;187m║"
        },
        {
            "type": "disk",
            "key": "\u001b[38;2;191;120;187m║\u001b[38;2;227;226;232m  ENT PLUG ▌                                         \u001b[38;2;191;120;187m║",
            "folders": "/"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;191;120;187m╠══════════════════════════════════════════════════════╣"
        },

        // --- SECTION 2: DESKTOP (COMMAND UI) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;191;120;187m║ \u001b[38;2;118;141;219mCOMMAND INTERFACE                              \u001b[38;2;191;120;187m      ║"
        },{
            "type": "os",
            "key": "\u001b[38;2;191;120;187m║\u001b[38;2;227;226;232m  SYSTEM   ▌                                         \u001b[38;2;191;120;187m║",
            "format": "Asahi ALARM (Arch Linux)"
        },

        {
            "type": "kernel",
            "key": "\u001b[38;2;191;120;187m║\u001b[38;2;227;226;232m  KERNEL   ▌                                         \u001b[38;2;191;120;187m║",
        	"format": "{1} {2~0,7} {2~12,50}"
		},
        {
            "type": "wm",
            "key": "\u001b[38;2;191;120;187m║\u001b[38;2;227;226;232m  VISUAL   ▌                                         \u001b[38;2;191;120;187m║",
            "format": "{2} ({3})"
        },
        {
            "type": "custom",
            "key": "\u001b[38;2;191;120;187m║\u001b[38;2;227;226;232m 󰾲 G-DRIVER ▌                                         \u001b[38;2;191;120;187m║",
            "format": "Asahi (Apple Silicon)"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;191;120;187m╠══════════════════════════════════════════════════════╣"
        },

        // --- SECTION 3: DEVELOPMENT (LANGUAGE PROTOCOLS) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;191;120;187m║ \u001b[38;2;118;141;219mLANGUAGE PROTOCOLS                                   \u001b[38;2;191;120;187m║"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;191;120;187m║\u001b[38;2;227;226;232m  RUST     ▌                                         \u001b[38;2;191;120;187m║",
            "text": "rustc --version | awk '{print $2}'"
        },
		 {
            "type": "command",
            "key": "\u001b[38;2;191;120;187m║\u001b[38;2;227;226;232m  NODE     ▌                                         \u001b[38;2;191;120;187m║",
            "text": "node --version 2>/dev/null || echo 'N/A'"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;191;120;187m║\u001b[38;2;227;226;232m  GO       ▌                                         \u001b[38;2;191;120;187m║",
            "text": "go version 2>/dev/null | awk '{print $3}' || echo 'N/A'"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;191;120;187m║\u001b[38;2;227;226;232m 󰊢 GIT      ▌                                         \u001b[38;2;191;120;187m║",
            "text": "git --version | awk '{print $3}'"
        },
        {
            "type": "editor",
            "key": "\u001b[38;2;191;120;187m║\u001b[38;2;227;226;232m 󱞎 EDITOR   ▌                                         \u001b[38;2;191;120;187m║"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;191;120;187m╠══════════════════════════════════════════════════════╣"
        },

        // --- SECTION 4: MISSION STATUS (UPTIME) ---
        {
            "type": "custom",
            "format": "\u001b[38;2;191;120;187m║ \u001b[38;2;118;141;219mMISSION STATUS                                       \u001b[38;2;191;120;187m║"
        },
        {
            "type": "uptime",
            "key": "\u001b[38;2;191;120;187m║\u001b[38;2;227;226;232m  ACTIVE   ▌                                         \u001b[38;2;191;120;187m║"
        },
        {
            "type": "packages",
            "key": "\u001b[38;2;191;120;187m║\u001b[38;2;227;226;232m 󰏖 PAYLOAD  ▌                                         \u001b[38;2;191;120;187m║"
        },
        {
            "type": "battery",
            "key": "\u001b[38;2;191;120;187m║\u001b[38;2;227;226;232m  PWR CELL ▌                                         \u001b[38;2;191;120;187m║",
			"format": "{4} ({15} remaining)"
        },
        {
            "type": "command",
            "key": "\u001b[38;2;191;120;187m║\u001b[38;2;227;226;232m  PLAYBACK ▌                                         \u001b[38;2;191;120;187m║",
            "text": "bash /home/river/.config/waybar/scripts/mpk.sh|cut -c -37"
        },
        {
            "type": "custom",
            "format": "\u001b[38;2;191;120;187m╚══════════════════════════════════════════════════════╝"
